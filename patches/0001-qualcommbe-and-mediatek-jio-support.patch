diff --git a/target/linux/qualcommbe/dts/ipq9554-jiorouter-ax6000-jidu6j11.dtsi b/target/linux/qualcommbe/dts/ipq9554-jiorouter-ax6000-jidu6j11.dtsi
new file mode 100644
index 0000000000..93471b4cb2
--- /dev/null
+++ b/target/linux/qualcommbe/dts/ipq9554-jiorouter-ax6000-jidu6j11.dtsi
@@ -0,0 +1,858 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "ipq9574.dtsi"
+
+/ {
+	model = "JioRouter AX6000 JIDU6J11";
+	compatible = "jiorouter,ax6000-jidu6j11", "qcom,ipq9574";
+
+	aliases {
+		serial0 = &blsp1_uart2;
+		led-boot = &led_red;
+		led-failsafe = &led_red;
+		led-running = &led_green;
+		led-upgrade = &led_blue;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x20000000>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&gpio_keys_default>;
+		pinctrl-names = "default";
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&tlmm 10 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&gpio_leds_default>;
+		pinctrl-names = "default";
+
+		led_red: led-0 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+
+		led_green: led-1 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_blue: led-2 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	ipq9574_s1: regulator-cpu {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <1075000>;
+		regulator-max-microvolt = <1075000>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-name = "cpu-vdd";
+	};
+
+	vdd_3p3: regulator-3p3 {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-name = "fixed_3p3";
+	};
+
+	vdd_0p925: regulator-0p925 {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <925000>;
+		regulator-max-microvolt = <925000>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-name = "fixed_0p925";
+	};
+
+	vdd_usb_phy: vdd-usb-phy {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+		vin-supply = <&vdd_3p3>;
+		regulator-name = "vdd_usb_phy";
+	};
+
+};
+
+&q6_region {
+	reg = <0x0 0x4ab00000 0x0 0x2d00000>;
+	status = "okay";
+};
+
+&cpu_opp_table {
+	opp-936000000 {
+		opp-microvolt = <1075000>;
+	};
+
+	opp-1104000000 {
+		opp-microvolt = <1075000>;
+	};
+
+	opp-1200000000 {
+		opp-microvolt = <1075000>;
+	};
+
+	opp-1416000000 {
+		opp-microvolt = <1075000>;
+	};
+
+	opp-1488000000 {
+		opp-microvolt = <1075000>;
+	};
+};
+
+&blsp1_uart2 {
+	pinctrl-0 = <&uart2_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&crypto {
+	status = "disabled";
+};
+
+&cryptobam {
+	status = "disabled";
+};
+
+&rpm {
+	status = "disabled";
+};
+
+&qcom_ppe {
+	assigned-clocks = <&nsscc NSS_CC_PORT1_RX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT1_TX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT2_RX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT2_TX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT3_RX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT3_TX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT4_RX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT4_TX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT5_RX_CLK_SRC>,
+			   <&nsscc NSS_CC_PORT5_TX_CLK_SRC>;
+
+	assigned-clock-rates = <125000000>, <125000000>, <125000000>,
+			       <125000000>, <125000000>, <125000000>,
+			       <125000000>, <125000000>, <125000000>,
+			       <125000000>;
+
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			label = "wan";
+			phy-mode = "psgmii";
+			managed = "in-band-status";
+			nvmem-cells = <&base_mac 0>;
+			nvmem-cell-names = "mac-address";
+			phy-handle = <&qca8075_0>;
+			pcs-handle = <&pcs0_ch0>;
+			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT1_RX_CLK>,
+				 <&nsscc NSS_CC_PORT1_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc PORT1_MAC_ARES>,
+				 <&nsscc PORT1_RX_ARES>,
+				 <&nsscc PORT1_TX_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+		};
+
+		port@2 {
+			reg = <2>;
+			label = "lan1";
+			phy-mode = "psgmii";
+			managed = "in-band-status";
+			nvmem-cells = <&base_mac 1>;
+			nvmem-cell-names = "mac-address";
+			phy-handle = <&qca8075_1>;
+			pcs-handle = <&pcs0_ch1>;
+			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT2_RX_CLK>,
+				 <&nsscc NSS_CC_PORT2_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc PORT2_MAC_ARES>,
+				 <&nsscc PORT2_RX_ARES>,
+				 <&nsscc PORT2_TX_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+		};
+
+		port@3 {
+			reg = <3>;
+			label = "lan2";
+			phy-mode = "psgmii";
+			managed = "in-band-status";
+			nvmem-cells = <&base_mac 1>;
+			nvmem-cell-names = "mac-address";
+			phy-handle = <&qca8075_2>;
+			pcs-handle = <&pcs0_ch2>;
+			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT3_RX_CLK>,
+				 <&nsscc NSS_CC_PORT3_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc PORT3_MAC_ARES>,
+				 <&nsscc PORT3_RX_ARES>,
+				 <&nsscc PORT3_TX_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+		};
+
+		port@4 {
+			reg = <4>;
+			label = "lan3";
+			phy-mode = "psgmii";
+			managed = "in-band-status";
+			nvmem-cells = <&base_mac 1>;
+			nvmem-cell-names = "mac-address";
+			phy-handle = <&qca8075_3>;
+			pcs-handle = <&pcs0_ch3>;
+			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT4_RX_CLK>,
+				 <&nsscc NSS_CC_PORT4_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc PORT4_MAC_ARES>,
+				 <&nsscc PORT4_RX_ARES>,
+				 <&nsscc PORT4_TX_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+		};
+
+		port@5 {
+			reg = <5>;
+			label = "lan4";
+			phy-mode = "psgmii";
+			managed = "in-band-status";
+			nvmem-cells = <&base_mac 1>;
+			nvmem-cell-names = "mac-address";
+			phy-handle = <&qca8075_4>;
+			pcs-handle = <&pcs0_ch4>;
+			clocks = <&nsscc NSS_CC_PORT5_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT5_RX_CLK>,
+				 <&nsscc NSS_CC_PORT5_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc PORT5_MAC_ARES>,
+				 <&nsscc PORT5_RX_ARES>,
+				 <&nsscc PORT5_TX_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+	reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
+
+	ethernet-phy-package@10 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "qcom,qca8075-package";
+		reg = <0x10>;
+
+		qca8075_0: ethernet-phy@10 {
+			reg = <0x10>;
+		};
+
+		qca8075_1: ethernet-phy@11 {
+			reg = <0x11>;
+		};
+
+		qca8075_2: ethernet-phy@12 {
+			reg = <0x12>;
+		};
+
+		qca8075_3: ethernet-phy@13 {
+			reg = <0x13>;
+		};
+
+		qca8075_4: ethernet-phy@14 {
+			reg = <0x14>;
+		};
+	};
+};
+
+&pcs0 {
+	pcs0_ch4: pcs-mii@4 {
+		reg = <4>;
+		clocks = <&nsscc NSS_CC_UNIPHY_PORT5_RX_CLK>,
+			 <&nsscc NSS_CC_UNIPHY_PORT5_TX_CLK>;
+		clock-names = "rx", "tx";
+	};
+};
+
+&pcs1 {
+	status = "disabled";
+};
+
+&pcs2 {
+	status = "disabled";
+};
+
+&pcie1_phy {
+	status = "okay";
+};
+
+&pcie1 {
+	pinctrl-0 = <&pcie_qcn9074_pins>;
+	pinctrl-names = "default";
+	perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	pcie@0 {
+		device_type = "pci";
+		reg = <0x0 0x0 0x0 0x0 0x0>;
+		bus-range = <0x01 0xff>;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi1: wifi@0,0 {
+			compatible = "pci17cb,1104";
+			reg = <0x00010000 0 0 0 0>;
+			qcom,ath11k-fw-memory-mode = <2>;
+			nvmem-cells = <&base_mac 3>;
+			nvmem-cell-names = "mac-address";
+		};
+	};
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	pinctrl-0 = <&qpic_snand_default_state>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		nand-ecc-engine = <&qpic_nand>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x00000000 0x00180000>;
+				read-only;
+			};
+
+			partition@180000 {
+				label = "0:SBL1_1";
+				reg = <0x00180000 0x00180000>;
+				read-only;
+			};
+
+			partition@300000 {
+				label = "0:MIBIB";
+				reg = <0x00300000 0x00100000>;
+				read-only;
+			};
+
+			partition@400000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x00400000 0x00080000>;
+				read-only;
+			};
+
+			partition@480000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x00480000 0x00080000>;
+				read-only;
+			};
+
+			partition@500000 {
+				label = "0:QSEE";
+				reg = <0x00500000 0x00380000>;
+				read-only;
+			};
+
+			partition@880000 {
+				label = "0:QSEE_1";
+				reg = <0x00880000 0x00380000>;
+				read-only;
+			};
+
+			partition@c00000 {
+				label = "0:DEVCFG_1";
+				reg = <0x00c00000 0x00080000>;
+				read-only;
+			};
+
+			partition@c80000 {
+				label = "0:DEVCFG";
+				reg = <0x00c80000 0x00080000>;
+				read-only;
+			};
+
+			partition@d00000 {
+				label = "0:APDP_1";
+				reg = <0x00d00000 0x00080000>;
+				read-only;
+			};
+
+			partition@d80000 {
+				label = "0:APDP";
+				reg = <0x00d80000 0x00080000>;
+				read-only;
+			};
+
