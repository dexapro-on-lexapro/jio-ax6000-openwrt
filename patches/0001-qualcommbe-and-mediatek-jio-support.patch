--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0704-remoteproc-qcom-q6v5-wcss-add-ipq9574-support.patch
@@ -0,0 +1,541 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Igor Kravchenko <igor.kravchenko05@gmail.com>
+Date: Fri, 24 Jul 2026 12:00:00 +0000
+Subject: [PATCH] remoteproc: qcom_q6v5_wcss: add IPQ9574 support
+
+Add the IPQ9574 WCSS data and reset/start/stop sequence used by the
+native Q6 firmware loader. This lets the IPQ9574 q6v5_wcss node bind as a
+remoteproc provider for the integrated ath11k AHB device.
+
+Also load the optional M3 firmware image used by IPQ9574 firmware
+packages and point the IPQ9574 firmware names at OpenWrt's ath11k
+firmware installation path.
+
+Signed-off-by: Alexandru Gagniuc <mr.nuke.me@gmail.com>
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+--- a/drivers/remoteproc/qcom_q6v5_wcss.c
++++ b/drivers/remoteproc/qcom_q6v5_wcss.c
+@@ -31,6 +31,9 @@
+ #define Q6SS_MEM_PWR_CTL		0x0B0
+ #define Q6SS_STRAP_ACC			0x110
+ #define Q6SS_CGC_OVERRIDE		0x034
++#define Q6SS_BOOT_CORE_START		0x400
++#define Q6SS_BOOT_CMD                   0x404
++#define Q6SS_BOOT_STATUS		0x408
+ #define Q6SS_BCR_REG			0x6000
+ 
+ /* AXI Halt Register Offsets */
+@@ -48,7 +51,11 @@
+ /* Q6SS_BRC_RESET */
+ #define Q6SS_BRC_BLK_ARES		BIT(0)
+ 
++/* QDSP6SS CBCR */
++#define Q6SS_CBCR_CLKEN			BIT(0)
++
+ /* Q6SS_GFMUX_CTL */
++#define Q6SS_CLK_SRC_MUX		BIT(0)
+ #define Q6SS_CLK_ENABLE			BIT(1)
+ #define Q6SS_SWITCH_CLK_SRC		BIT(8)
+ 
+@@ -67,6 +74,7 @@
+ #define HALT_CHECK_MAX_LOOPS		200
+ #define Q6SS_XO_CBCR		GENMASK(5, 3)
+ #define Q6SS_SLEEP_CBCR		GENMASK(5, 2)
++#define Q6SS_CORE_CBCR		BIT(5)
+ 
+ /* Q6SS config/status registers */
+ #define TCSR_GLOBAL_CFG0	0x0
+@@ -77,9 +85,11 @@
+ #define Q6SS_RST_EVB		0x10
+ 
+ #define BHS_EN_REST_ACK		BIT(0)
++#define WCSS_HM_RET		BIT(1)
+ #define SSCAON_ENABLE		BIT(13)
+ #define SSCAON_BUS_EN		BIT(15)
+ #define SSCAON_BUS_MUX_MASK	GENMASK(18, 16)
++#define SSCAON_MASK             GENMASK(17, 15)
+ 
+ #define MEM_BANKS		19
+ #define TCSR_WCSS_CLK_MASK	0x1F
+@@ -88,11 +98,13 @@
+ #define MAX_HALT_REG		4
+ enum {
+ 	WCSS_IPQ8074,
++	WCSS_IPQ9574,
+ 	WCSS_QCS404,
+ };
+ 
+ struct wcss_data {
+-	const char *firmware_name;
++	const char *q6_firmware_name;
++	const char *m3_firmware_name;
+ 	unsigned int crash_reason_smem;
+ 	u32 version;
+ 	bool aon_reset_required;
+@@ -102,6 +114,7 @@ struct wcss_data {
+ 	int ssctl_id;
+ 	const struct rproc_ops *ops;
+ 	bool requires_force_stop;
++	bool auto_boot;
+ };
+ 
+ struct q6v5_wcss {
+@@ -128,6 +141,12 @@ struct q6v5_wcss {
